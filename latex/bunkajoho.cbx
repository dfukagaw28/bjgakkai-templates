%% bunkajoho.cbx
%% 紀要「文化情報学」執筆要項 7. に基づく本文中引用書式（authoryear-comp ベース）
%%   \citet{gibson1979}                → Gibson （1979）
%%   \citep{saeki1990}                 → （佐伯・佐々木, 1990）
%%   \citet[p.123]{haugeland1987}      → Haugeland （1987, p.123）
%%   \citet{simon1973,simon1981}       → Simon （1973, 1981）
%%   \citep{cohen1990a,cohen1990b}     → （Cohen & Levesque, 1990a, 1990b）
%%   \citep{anzai1992,joshi1981,...}   → （安西 他, 1992; Joshi et al., 1981; Minsky, 1975, 1986）
%% 括弧は要項の例に合わせ、和文論文では全角（ ）、英語論文では半角 ( ) を使う。
%% （\bjciteopen / \bjciteclose で切り替え。クラスファイルが english オプションで設定する）
\ProvidesFile{bunkajoho.cbx}[2026/09/29 v0.2 Bunka Joho citation style]
\RequireCitationStyle{authoryear-comp}

\providecommand*{\ifentryjapanese}{\iffieldequalstr{langid}{japanese}}
\providecommand*{\bjciteopen}{（}
\providecommand*{\bjciteclose}{）}

%% 引用中の著者名: 姓のみ（区切りは bbx の multinamedelim / finalnamedelim）
\DeclareNameFormat{labelname}{%
  \usebibmacro{name:delim}{\namepartfamily}%
  \usebibmacro{name:hook}{\namepartfamily}%
  \mkbibnamefamily{\namepartfamily}%
  \usebibmacro{name:andothers}}

%% 区切り記号
\DeclareDelimFormat{nameyeardelim}{\addcomma\space}                  % （Gibson, 1979）
\DeclareDelimFormat[textcite]{nameyeardelim}{\ifentryjapanese{}{\addspace}} % Gibson （1979）/ 佐伯・佐々木（1990）
\DeclareDelimFormat{multicitedelim}{\addsemicolon\space}              % ; で区切る
\DeclareDelimFormat{compcitedelim}{\addcomma\space}                   % Simon （1973, 1981）
\DeclareDelimFormat{postnotedelim}{\addcomma\space}                   % Haugeland （1987, p.123）
\DeclareFieldFormat{postnote}{#1}                                     % p.123 はユーザが書く
\DeclareFieldFormat{multipostnote}{#1}

%% 同一著者・同一年でも年を省略しない: 1990a, 1990b（authoryear-comp の既定は 1990a,b）
%% authoryear-comp は直前に \setunit{\addcomma} を置くので、ここで区切りを上書きする
\renewbibmacro*{cite:extradate}{%
  \setunit{\addcomma\space}%
  \usebibmacro{cite:labeldate+extradate}}

%% 括弧: \citet は \bibopenparen / \bibcloseparen、\citep は独自のラッパーで付ける
\AtEveryCite{%
  \let\bibopenparen\bjciteopen
  \let\bibcloseparen\bjciteclose}
\newcommand*{\bj@citeparens}[1]{\bjciteopen#1\bjciteclose}
\DeclareCiteCommand{\parencite}[\bj@citeparens]
  {\usebibmacro{cite:init}%
   \usebibmacro{prenote}}
  {\usebibmacro{citeindex}%
   \usebibmacro{cite}}
  {}
  {\usebibmacro{postnote}}
\DeclareCiteCommand*{\parencite}[\bj@citeparens]
  {\usebibmacro{cite:init}%
   \usebibmacro{prenote}}
  {\usebibmacro{citeindex}%
   \usebibmacro{citeyear}}
  {}
  {\usebibmacro{postnote}}

%% 複数の \citep をまとめる \parencites も同じ括弧（pandoc は [@a; @b, p.3] を \autocites で出力する）
\DeclareMultiCiteCommand{\parencites}[\bj@citeparens]{\parencite}{\multicitedelim}

%% \cite も \citep と同じく括弧付き
\DeclareCiteCommand{\cite}[\bj@citeparens]
  {\usebibmacro{cite:init}%
   \usebibmacro{prenote}}
  {\usebibmacro{citeindex}%
   \usebibmacro{cite}}
  {}
  {\usebibmacro{postnote}}

%% natbib 風の \citet / \citep（\textcite / \parencite と同じ）
\newcommand*{\citet}{\textcite}
\newcommand*{\citep}{\parencite}
\endinput
